		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
