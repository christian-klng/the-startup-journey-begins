# Copy to .env for local development. On Coolify set these as environment variables.
SCALEWAY_API_KEY=
SCALEWAY_BASE_URL=https://api.scaleway.ai/v1
SCALEWAY_MODEL=llama-3.3-70b-instruct
ADMIN_PASSWORD=change-me
# Public URL phones use; printed under the QR codes.
PUBLIC_BASE_URL=http://localhost:3000
# SvelteKit CSRF origin check; must equal PUBLIC_BASE_URL
ORIGIN=http://localhost:3000
DATABASE_PATH=./data/game.sqlite
CONTENT_DIR=./content
MIGRATIONS_DIR=./drizzle
MAX_TEAMS=40
PORT=3000
